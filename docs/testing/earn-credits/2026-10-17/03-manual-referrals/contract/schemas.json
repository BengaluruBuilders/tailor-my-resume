{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tmr:manual-referrals-v1",
  "$comment": "Wire shapes only. Semantic preconditions, canonicalization, status/amount consistency and lifetime rules are normative in BACKEND_CONTRACT section10. No schema download or runtime dependency.",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "continuity": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "enum": [
                "ANDROID_ID"
              ]
            },
            "value": {
              "allOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                },
                {
                  "not": {
                    "enum": [
                      "0000000000000000",
                      "9774d56d682e549c"
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient",
        "amount",
        "status",
        "policyVersion"
      ],
      "properties": {
        "recipient": {
          "enum": [
            "INVITER"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "status": {
          "enum": [
            "GRANTED"
          ]
        },
        "policyVersion": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        }
      }
    },
    "attachment": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "status",
            "source",
            "attachedAt",
            "reward"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "status": {
              "enum": [
                "ATTACHED"
              ]
            },
            "source": {
              "enum": [
                "MANUAL",
                "LINK"
              ]
            },
            "attachedAt": {
              "type": "string",
              "format": "date-time"
            },
            "reward": {
              "$ref": "#/$defs/reward"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "code": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "createdAt"
          ],
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}\\.[a-z][a-z0-9-]{0,31}\\.[a-z2-7]{32}$",
              "maxLength": 98
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "shareUrl": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^https://[^/?#]+/[^?#]*$",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creditedCount",
        "earnedCredits"
      ],
      "properties": {
        "creditedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "earnedCredits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "version",
        "effectiveAt",
        "expiresAt",
        "rewardAmount",
        "codeIssuance",
        "attachmentEligibility",
        "deadline",
        "continuityMode"
      ],
      "properties": {
        "status": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        },
        "reason": {
          "enum": [
            "ELIGIBLE",
            "GOOGLE_REQUIRED",
            "ACTIVATION_REQUIRED",
            "EXISTING_ACCOUNT",
            "AMBIGUOUS_HISTORY",
            "RECOVERY_EXPIRED",
            "ALREADY_ATTACHED",
            "WINDOW_EXPIRED",
            "POLICY_UNAVAILABLE",
            "ADMISSIONS_DISABLED",
            "CAMPAIGN_EXHAUSTED"
          ]
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "effectiveAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "rewardAmount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "codeIssuance": {
          "enum": [
            "AVAILABLE",
            "GOOGLE_REQUIRED",
            "ACTIVATION_REQUIRED",
            "UNAVAILABLE"
          ]
        },
        "attachmentEligibility": {
          "enum": [
            "ELIGIBLE",
            "ATTACHED",
            "EXPIRED",
            "NOT_ELIGIBLE",
            "UNAVAILABLE",
            "GOOGLE_REQUIRED"
          ]
        },
        "deadline": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "continuityMode": {
          "enum": [
            "NONE",
            "OPTIONAL"
          ]
        }
      }
    },
    "issueRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "challengeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "requestId",
        "policyVersion",
        "payloadDigest"
      ],
      "properties": {
        "operation": {
          "enum": [
            "REFERRAL_ATTACH"
          ]
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "policyVersion": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "attachRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "code",
        "source",
        "policyVersion",
        "continuity",
        "challengeId",
        "integrityToken"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[\\x00-\\x7f]{1,256}$"
        },
        "source": {
          "enum": [
            "MANUAL",
            "LINK"
          ]
        },
        "policyVersion": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "continuity": {
          "$ref": "#/$defs/continuity"
        },
        "challengeId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "integrityToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      }
    },
    "challengeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challengeId",
        "challenge",
        "expiresAt",
        "bindingVersion",
        "requestHash"
      ],
      "properties": {
        "challengeId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "challenge": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "bindingVersion": {
          "enum": [
            1
          ]
        },
        "requestHash": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "meResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "shareUrl",
        "offer",
        "attachment",
        "stats"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "shareUrl": {
          "$ref": "#/$defs/shareUrl"
        },
        "offer": {
          "$ref": "#/$defs/offer"
        },
        "attachment": {
          "$ref": "#/$defs/attachment"
        },
        "stats": {
          "$ref": "#/$defs/stats"
        }
      }
    },
    "issueResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "shareUrl",
        "offer",
        "replayed"
      ],
      "properties": {
        "code": {
          "allOf": [
            {
              "$ref": "#/$defs/code"
            },
            {
              "not": {
                "type": "null"
              }
            }
          ]
        },
        "shareUrl": {
          "$ref": "#/$defs/shareUrl"
        },
        "offer": {
          "$ref": "#/$defs/offer"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "attachResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attachment",
        "reward",
        "replayed"
      ],
      "properties": {
        "attachment": {
          "allOf": [
            {
              "$ref": "#/$defs/attachment"
            },
            {
              "not": {
                "type": "null"
              }
            }
          ]
        },
        "reward": {
          "$ref": "#/$defs/reward"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "exportReferrals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "attachment",
        "stats"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "attachment": {
          "$ref": "#/$defs/attachment"
        },
        "stats": {
          "$ref": "#/$defs/stats"
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    }
  }
}
