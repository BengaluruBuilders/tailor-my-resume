{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tmr:referral-links-v1",
  "$comment": "Only new logical packaging inputs/static outputs. Existing authenticated responses/attach schema stay section10/03 fixtures. Origin allowlist, package/environment association, temporal bounds and snapshot source coherence also require semantic validation. These are not public API inputs.",
  "$defs": {
    "linkConfig": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "const": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "appId",
            "environment",
            "origin",
            "allowedOrigins",
            "packageName",
            "sha256CertFingerprints",
            "publicOffer"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "appId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            },
            "environment": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            },
            "origin": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^https://[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
            },
            "allowedOrigins": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^https://[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
              }
            },
            "packageName": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
            },
            "sha256CertFingerprints": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(?:[A-F0-9]{2}:){31}[A-F0-9]{2}$"
              }
            },
            "publicOffer": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "const": "NEUTRAL"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "maxAgeSeconds",
                    "maxValiditySeconds"
                  ],
                  "properties": {
                    "mode": {
                      "const": "SNAPSHOT"
                    },
                    "maxAgeSeconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "maxValiditySeconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "offerSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "environment",
        "version",
        "effectiveAt",
        "expiresAt",
        "availability",
        "rewardAmount"
      ],
      "properties": {
        "appId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "environment": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "effectiveAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "availability": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        },
        "rewardAmount": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "assetlinks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation",
          "target"
        ],
        "properties": {
          "relation": {
            "const": [
              "delegate_permission/common.handle_all_urls"
            ]
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "package_name",
              "sha256_cert_fingerprints"
            ],
            "properties": {
              "namespace": {
                "const": "android_app"
              },
              "package_name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
              },
              "sha256_cert_fingerprints": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(?:[A-F0-9]{2}:){31}[A-F0-9]{2}$"
                }
              }
            }
          }
        }
      }
    },
    "code": {
      "type": "string",
      "maxLength": 98,
      "pattern": "^[a-z][a-z0-9-]{0,31}\\.[a-z][a-z0-9-]{0,31}\\.[a-z2-7]{32}$"
    }
  }
}
